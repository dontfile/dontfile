<% title @page.url %>
<%= turbo_stream_from @page %>

<h1>Dontfile</h1>

<div id="container">
  <%= form_with model: @page, url: page_path(@page.url), method: :patch, id: "text-area",
        data: { controller: "autosave", action: "input->autosave#queue turbo:submit-end->autosave#saved turbo:before-morph-element->autosave#preserveTyping" } do |form| %>
    <h2><%= form.label :content, "Text" %></h2>
    <%= form.text_area :content, id: "text", data: { autosave_target: "text" } %>
  <% end %>

  <h2><label for="file">File</label></h2>
  <div id="file-area">
    <%= form_with model: @page, url: page_file_path(@page.url), method: :patch,
          data: { controller: "upload", upload_max_size_value: Page.max_file_size,
                   upload_too_big_message_value: "File is too big. Max size is #{number_to_human_size(Page.max_file_size)}." } do |form| %>
      <h4>(Max size: <%= number_to_human_size(Page.max_file_size) %>)</h4>
      <%= form.file_field :file, id: "file", data: { upload_target: "input", action: "upload#submit" } %>
      <noscript><%= form.button "Upload" %></noscript>
      <progress data-upload-target="progress" value="0" hidden></progress>
    <% end %>

    <div id="attachment">
      <% if @page.file.attached? %>
        <%= attachment_icon(@page.file.content_type) %>
        <p><%= @page.file.filename %></p>

        <div id="buttons">
          <%= link_to rails_blob_path(@page.file, disposition: "attachment"), class: "button", title: "Download File" do %>
            <%= render "icons/arrow_down_circle" %>
          <% end %>

          <%= button_to page_file_path(@page.url), method: :delete, title: "Delete File", class: "button",
                form: { data: { turbo_confirm: "Are you sure?" } } do %>
            <%= render "icons/trash" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
